{
  "branches": [
    "main",
    { "name": "claude/*", "prerelease": "beta-${name.replace(/[^0-9A-Za-z-]/g, '-')}" },
    { "name": "feature/*", "prerelease": "beta-${name.replace(/[^0-9A-Za-z-]/g, '-')}" },
    { "name": "feat/*", "prerelease": "beta-${name.replace(/[^0-9A-Za-z-]/g, '-')}" },
    { "name": "fix/*", "prerelease": "beta-${name.replace(/[^0-9A-Za-z-]/g, '-')}" }
  ],
  "tagFormat": "v${version}",
  "plugins": [
    ["@semantic-release/commit-analyzer", {
      "preset": "conventionalcommits",
      "releaseRules": [
        { "type": "perf", "release": "patch" },
        { "type": "refactor", "release": "patch" },
        { "type": "build", "release": "patch" }
      ]
    }],
    ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
    ["@semantic-release/exec", {
      "prepareCmd": "scripts/release-build.sh ${nextRelease.version}"
    }],
    ["@semantic-release/github", {
      "assets": [
        { "path": "build/Espazio-*.dmg", "label": "Espazio ${nextRelease.version} (DMG)" },
        { "path": "build/Espazio-*.pkg", "label": "Espazio ${nextRelease.version} (PKG)" }
      ],
      "successComment": false,
      "failComment": false,
      "releasedLabels": false
    }]
  ]
}
